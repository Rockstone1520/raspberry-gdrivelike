# Copia este archivo a .env y ajústalo:  cp .env.example .env

# Ruta en la Pi donde está montada la SSD (carpeta de datos)
DATA_PATH=/mnt/ssd/drive

# uid/gid de tu usuario en la Pi (comando: id)
PUID=1000
PGID=1000

# Usuario inicial (solo se usa si aún no hay usuarios). Luego puedes borrar la contraseña de aquí.
ADMIN_USER=tu_usuario
ADMIN_PASSWORD=cambia-esta-clave

# 127.0.0.1 = solo local (recomendado, con `tailscale serve`).
# Pon la IP de Tailscale de la Pi (100.x.y.z) si prefieres acceder sin serve.
BIND_ADDR=127.0.0.1
PORT=8070

# true cuando accedas por HTTPS (tailscale serve)
COOKIE_SECURE=false
MAX_UPLOAD_GB=50
